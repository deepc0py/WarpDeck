// Fix 2: Improve announcement with proper TTL
void MdnsManager::send_service_announcement() {
    // ... existing code ...
    
    // Set proper TTL for records (120 seconds is standard)
    for (auto& record : records) {
        record.ttl = 120;
        record.cache_flush = 1;  // Cache flush bit for unique records
    }
    
    // Send on all interfaces
    for (int sock : sockets_) {
        int result = mdns_announce_multicast(sock, buffer, sizeof(buffer),
                                            record, nullptr, 0, additional, additional_count);
        if (result < 0) {
            Logger::instance().error("MdnsManager", "Announcement failed: " + std::strerror(errno));
        }
    }
}
